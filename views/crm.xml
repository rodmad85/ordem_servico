<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="os_crm_tree_view" model="ir.ui.view">
            <field name="name">os.crm.tree</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_case_tree_view_oppor" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='tag_ids']" position="after">
                    <field name="write_date"/>
                </xpath>
            </field>
        </record>

        <record id="os_crm_form_view" model="ir.ui.view">
            <field name="name">os.crm.form</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_lead_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='tag_ids']" position="attributes">
                    <attribute name="required">True</attribute>
                </xpath>
                <xpath expr="//field[@name='medium_id']" position="attributes">
                    <attribute name="required">True</attribute>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
