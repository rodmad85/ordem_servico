<?xml version="1.0" encoding="utf-8"?>
<!--
  -->

<odoo>
    
        <record id="stock_os_form" model="ir.ui.view">
       <field name="name">stock.os.form</field>
       <field name="inherit_id" ref="stock.view_stock_quant_tree_editable" />
       <field name="model">stock.quant</field>
       <field name="arch" type="xml">
           <xpath expr="//field[@name='location_id']" position="after">
               <field name="obs" />
           </xpath>
       </field>
   </record>


        <record id="stock_os_raw_form" model="ir.ui.view">
       <field name="name">stock.os.raw.form</field>
       <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree" />
       <field name="model">stock.move.line</field>
       <field name="arch" type="xml">
           <xpath expr="//tree/field[@name='product_uom_id']" position="after">
               <field name="funcionario" options="{'no_create_edit': True,'no_create': True}"/>
               <field name="create_date"/>
               <field name="create_uid"/>
           </xpath>
       </field>
   </record>

    <record id="stock_os_picking_tree" model="ir.ui.view">
       <field name="name">stock.os.picking.tree</field>
       <field name="inherit_id" ref="stock.vpicktree" />
       <field name="model">stock.picking</field>
       <field name="arch" type="xml">
           <xpath expr="//field[@name='partner_id']" position="after">
                <field name="ordem_servico" widget="many2many_tags" string="OS"/>
            </xpath>
       </field>
    </record>

    <record id="stock_quant_os" model="ir.ui.view">
       <field name="name">stock.quant.os</field>
       <field name="inherit_id" ref="stock.view_picking_form" />
       <field name="model">stock.picking</field>
       <field name="arch" type="xml">

            <xpath expr="//field[@name='origin']" position="after">
                <field name="ordem_servico" widget="many2many_tags" string="OS"/>
            </xpath>


            <field name="location_dest_id" position="after">
                <field name="carrier_id" position="move" attrs="{'required': [('picking_type_id', '=', 2)]}"/>
                <field name="carrier_track_ref" string="Placa" attrs="{'required': [('picking_type_id', '=', 2)]}"/>
                <field name="rg_cpf" attrs="{'required': [('picking_type_id', '=', 2)]}"/>
                <field name="part_carrier" string="Motorista" attrs="{'required': [('picking_type_id', '=', 2)]}"/>
            </field>
           <xpath expr="//field[@name='move_ids_without_package']/tree" position="inside">
               <field name="funcionarios" options="{'no_create_edit': True,'no_create': True, 'invisible': [('picking_type_id', '=', 2)]}"/>
               <field name="ordem_servico" widget="many2many_tags" attrs="{'invisible': [('picking_type_id', '=', 2)]}"/>
               <field name="certificado" attrs="{'invisible': [('picking_type_id', '=', 2)]}"/>
            </xpath>


       </field>
   </record>



</odoo>