<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="os_maintenance_request_kanban" model="ir.ui.view">
        <field name="name">os.maintenance.request.kanban</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_kanban" />
        <field name="model">maintenance.request</field>
        <field name="arch" type="xml">

             <xpath expr="//t[@t-name='kanban-box']" position="replace">
            <t t-name="kanban-box">
                <div t-attf-class="{{!selection_mode ? 'oe_kanban_color_' + kanban_getcolor(record.color.raw_value) : ''}} oe_kanban_card oe_kanban_global_click oe_semantic_html_override">
                    <div class="o_dropdown_kanban dropdown">
                        <a role="button" class="dropdown-toggle o-no-caret btn" data-bs-toggle="dropdown" data-bs-display="static" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                            <span class="fa fa-ellipsis-v"/>
                        </a>
                        <div class="dropdown-menu" role="menu">
                            <t t-if="widget.editable"><a role="menuitem" type="edit" class="dropdown-item">Edit...</a></t>
                            <t t-if="widget.deletable"><a role="menuitem" type="delete" class="dropdown-item">Delete</a></t>
                            <ul class="oe_kanban_colorpicker" data-field="color"/>
                        </div>
                    </div>
                    <div class="oe_kanban_content" tooltip="kanban-tooltip">
                        <div class="o_kanban_record_top">
                            <b class="o_kanban_record_title"><field name="name"/></b>
                        </div>
                        <div class="o_kanban_record_body">
                            <!-- REMOVIDO: <span name="owner_user_id" t-if="record.owner_user_id.raw_value">Requested by : <field name="owner_user_id"/><br/></span> -->
                            <span class="oe_grey" t-if="record.equipment_id.raw_value"><b><field name="equipment_id"/></b><br/></span>
                            <span t-if="record.category_id.raw_value"><field name="category_id"/></span>
                        </div>
                        <div class="o_kanban_record_bottom">
                            <div class="oe_kanban_bottom_left">
                                <field name="priority" widget="priority"/>
                                <div class="o_kanban_inline_block ml4 mr4">
                                    <field name="activity_ids" widget="kanban_activity"/>
                                </div>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <field name="kanban_state" widget="state_selection"/>
                                <field name="user_id" widget="many2one_avatar_user"/>
                            </div>
                        </div>
                    </div>
                    <div class="clearfix"></div>
                </div>
            </t>
        </xpath>
        <xpath expr="//kanban" position="inside">
                <field name="funcionario"/>
            </xpath>
             <xpath expr="//div[@class='o_kanban_record_body']" position="inside">

                <span t-if="record.funcionario.raw_value">
                    <br/>
                    <b>Funcionário:</b> <field name="funcionario"/><br/>
                </span>
                 <span t-if="record.res_partner.raw_value">
                    <br/>
                    <b>Assistência:</b> <field name="res_partner"/><br/>
                </span>
            </xpath>




        </field>
    </record>

        <record id="os_maintenance_request_form" model="ir.ui.view">
        <field name="name">os.maintenance.request.form</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form" />
        <field name="model">maintenance.request</field>
        <field name="arch" type="xml">
             <xpath expr="//field[@name='equipment_id']" position="after">
                <field name="funcionario" string="Funcionario resposável"/>
             </xpath>

             <xpath expr="//field[@name='maintenance_team_id']" position="after">
                <field name="show_res_partner" invisible="1"/>
                <field name="res_partner" attrs="{'invisible': [('show_res_partner', '=', False)]}"/>
             </xpath>
        </field>
    </record>

       <record id="os_maintenance_request_tree" model="ir.ui.view">
        <field name="name">os.maintenance.request.tree</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_tree" />
        <field name="model">maintenance.request</field>
        <field name="arch" type="xml">
            <field name="employee_id" position="after">
                <field name="maintenance_team_id" groups="base.group_multi_company"/>
                <field name="res_partner"/>
            </field>
        </field>
       </record>
</odoo>