<?xml version="1.0" encoding="utf-8"?>
<!--
  -->

<odoo>
    <data>
        <record id="purchase_os_form_line" model="ir.ui.view">
        <field name="name">purchase.os.form</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="model">purchase.order</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/tree" position="inside">

                <field name="ordem_servico" string="OS" widget="many2many_tags"/>
            </xpath>

            <xpath expr="//field[@name='origin']" position="after">
               <field name="forma_pagamento" string="Forma de Pagamento" domain="[('state', '=', 'enabled')]"/>
                <field name="forma_pagamento_nome" invisible="1"/>

                            <field name="chave_pix" readonly="1" class="o_input"/>
<!--                                <div class="o_input_group_btn">-->
<!--                                    <button name="action_open_pix_wizard"-->
<!--                                            type="object"-->
<!--                                            string="Cadastrar"-->
<!--                                            class="btn btn-sm btn-success"-->
<!--                                            attrs="{-->
<!--                                                'invisible': ['|', ('forma_pagamento_nome', '!=', 'PIX'), ('partner_id', '=', False), ('chave_pix', '!=', False)]-->
<!--                                            }"/>-->

<!--                            </div>-->




            </xpath>

            <xpath expr="//field[@name='incoterm_id']" position="attributes">
               <attribute name="required">True</attribute>
            </xpath>

            <xpath expr="//field[@name='fiscal_position_id']" position="attributes">
               <attribute name="required">True</attribute>
            </xpath>

            <xpath expr="//field[@name='payment_term_id']" position="attributes">
               <attribute name="required">True</attribute>
            </xpath>

            <xpath expr="//tree" position="attributes">
                    <attribute name="default_order">qty_received asc</attribute>
                </xpath>

            <xpath expr="//form/sheet/notebook/page[2]" position="after">
                <page string="Total OS">

                    <group>
                        <button name="uposs" string="Atualizar" type="object" class="oe_link oe_edit_only fa fa-refresh"/>
                        <field name="oss" widget="section_and_note_one2many" mode="tree,kanban" nolabel="1">

                            <tree string="Total OS" editable="bottom">
                                <field name="os" string="Ordem de Serviço"/>
                                <field name="valor" sum="Total Geral"/>

                            </tree>
                        </field>
                    </group>
                </page>
                <page string="Certificados">
                    <field name="certificados" widget="many2many_binary"/>
                </page>
            </xpath>
        </field>
        </record>


        <record id="view_missing_pix_key_wizard_form" model="ir.ui.view">
    <field name="name">missing.pix.key.wizard.form</field>
    <field name="model">missing.pix.key.wizard</field>
    <field name="arch" type="xml">
      <form string="Chave PIX ausente">
        <group>
          <field name="partner_id" readonly="1"/>
        </group>
        <footer>
          <button name="action_choose_other_payment" string="Selecionar Outro Pagamento" type="object" class="btn-secondary"/>
          <button name="action_create_pix_key" string="Criar Chave PIX" type="object" class="btn-primary"/>
        </footer>
      </form>
    </field>
  </record>



    </data>
</odoo>
