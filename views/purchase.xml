<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Verificar posteriormente a remoção dos campos-->
    <record id="os_purchase_l10n_br_form" model="ir.ui.view">
        <field name="name">os.purchase.l10n_br.order.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="l10n_br_purchase.l10n_br_purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- 1. Removemos os campos da posição original (após partner_ref) -->
            <!--        <xpath expr="//field[@name='fiscal_operation_id']" position="attributes">-->
            <!--        </xpath>-->
            <xpath expr="//field[@name='ind_final']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
    <record id="os_purchase_order_form" model="ir.ui.view">
        <field name="name">os.purchase.order.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/tree" position="attributes">
                <attribute name="limit">200</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='price_subtotal']" position="before">
                <field name="ordem_servico" string="OS" widget="many2many_tags"/>
            </xpath>
            <xpath expr="//form/sheet/group[group]" position="replace">
                <group col="3" colspan="3">
                    <group col="1">
                        <field name="receipt_reminder_email" invisible="1"/>
                        <field name="partner_id"/>
                        <field name="vendedor" context="{'show_only_contact_name':True}" options="{'aways_reload':True}"/>
                        <field name="partner_ref"/>
                        <field name="currency_id" groups="base.group_multi_currency" force_save="1"/>
                        <field name="currency_id" invisible="1" groups="!base.group_multi_currency"/>
                        <field name="incoterm_id"/>
                        <field name="id" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                    <group name="pagamentos" col="1">
                        <field name="payment_term_id"/>
                        <field name="payment_mode_id" required="1"/>
                        <field name="payment_mode_id_name" invisible="1"/>
                        <field name="tipo_pix"/>
                        <field name="chave_pix"/>
                    </group>
                    <group col="1">
                        <field name="user_id" domain="[('share', '=', False)]" widget="many2one_avatar_user" />
                        <field name="date_order" attrs="{'invisible': [('state', 'in', ('purchase', 'done'))]}"/>
                        <field name="date_approve" attrs="{'invisible': [('state', 'not in', ('purchase', 'done'))]}"/>
                        <field name="mail_reception_confirmed" invisible="1"/>
                        <field name="date_planned" attrs="{'readonly': [('state', 'not in', ('draft', 'sent', 'to approve', 'purchase'))]}"/>
                        <field name="mail_reminder_confirmed" invisible="1"/>
                        <field name="reminder_date_before_receipt" attrs="{'invisible': [('receipt_reminder_email', '=', False)]}"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//button[@type='action' and contains(@context, 'search_default_partner_id')]" position="replace"/>
            <!-- Campos obrigatórios -->
            <xpath expr="//field[@name='incoterm_id']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>
            <xpath expr="//form" position="inside">
                <field name="effective_date" invisible="1"/>
            </xpath>
            <!-- Alterar ordenação padrão -->
            <xpath expr="//tree" position="attributes">
                <attribute name="default_order">qty_received asc</attribute>
            </xpath>
            <!-- Adicionar novas páginas -->
            <xpath expr="//form/sheet/notebook/page[2]" position="after">
                <page string="Total OS">
                    <group>
                        <button name="uposs" string="Atualizar" type="object" class="oe_link oe_edit_only fa fa-refresh"/>
                        <field name="oss" widget="section_and_note_one2many" mode="tree,kanban" nolabel="1">
                            <tree string="Total OS" editable="bottom">
                                <field name="os" string="Ordem de Serviço"/>
                                <field name="valor" sum="Total Geral"/>
                            </tree>
                        </field>
                    </group>
                </page>
                <page string="Certificados">
                    <field name="certificados" widget="many2many_binary"/>
                </page>
            </xpath>
        </field>
    </record>
    <record id="os_purchase_order_tree" model="ir.ui.view">
        <field name="name">os.purchase.order.tree</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_status']" position="after">
                <field name="state"/>
            </xpath>
            <xpath expr="//tree" position="inside">
                <header>
                    <button name="action_approve_all_purchases" groups="purchase.group_purchase_manager" string="Aprovar" class="btn-primary" invisible="0" type="object"/>
                </header>
            </xpath>
        </field>
    </record>
    <record id="purchase.purchase_form_action" model="ir.actions.act_window">
        <field name="domain">[('state', 'in', ['draft', 'sent', 'to approve','done','purchase'])]</field>
    </record>
</odoo>