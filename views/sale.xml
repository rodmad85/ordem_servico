<?xml version="1.0" encoding="utf-8"?>
<!--
  -->

<odoo>

        <record id="sale_order_os_form" model="ir.ui.view">
            <field name="name">sale.order.os.form</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="model">sale.order</field>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='sale_order_template_id']" position="after">

                    <field name="ordem_servico" widget="many2many_tags"/> <!--options="{'no_create': True}" context="{'tree_view_ref': False, 'kanban_view_ref': False}"-->


                </xpath>

               <xpath expr="//field[@name='payment_term_id']" position="after">
                    <field name="pedido" string="Pedido do Cliente"
                        widget="many2many"
                        domain="[('res_id', '=', active_id), ('res_model', '=', 'sale.order'),('name', '!=', False)]"
                        context="{
                            'default_res_model': 'sale.order',
                            'default_res_id': active_id,
                            'delete_warning': False,
                            'tree_view_ref': 'ordem_servico.custom_ir_attachment_tree_view'
                        }"
                        options="{
                            'create': True,
                            'delete': True
                        }"
                        attrs="{'readonly': [('state', 'in', ['sale', 'done'])], 'required': [('state', 'in', ['sale', 'done'])]}"/>
                    <field name="tag_ids" position="move"/>
                </xpath>
              
                <xpath expr="//field[@name='payment_term_id']" position="after">
                    <xpath expr="//field[@name='client_order_ref']" position="move"/>
                </xpath>

                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="grupo" invisible="1"/>
                </xpath>

                <xpath expr="//field[@name='fiscal_position_id']" position="attributes">
                    <attribute name="required">True</attribute>
                    <attribute name="attrs">{'readonly': [('state', 'in', ['sale', 'done'])]}</attribute>
                </xpath>

                <xpath expr="//field[@name='payment_term_id']" position="attributes">
                    <attribute name="required">True</attribute>
                    <attribute name="attrs">{'readonly': [('state', 'in', ['sale', 'done'])]}</attribute>
                </xpath>

                <xpath expr="//field[@name='incoterm']" position="attributes">
                    <attribute name="required">True</attribute>
                    <attribute name="attrs">{'readonly': [('state', 'in', ['sale', 'done'])]}</attribute>
                </xpath>

                <xpath expr="//field[@name='payment_term_id']" position="after">
                    <field name="incoterm" position="move"/>
                </xpath>
                
                <xpath expr="//field[@name='pricelist_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                
                <xpath expr="//field[@name='partner_id']" position="after">
                    <xpath expr="//field[@name='fiscal_position_id']" position="move"/>
                </xpath>

                <xpath expr="//field[@name='analytic_account_id']" position="after">
                    <xpath expr="//field[@name='pricelist_id']" position="move"/>
                </xpath>

                <xpath expr="//field[@name='fiscal_position_id']" position="after">
                    <xpath expr="//field[@name='tag_ids']" position="move"/>
                </xpath>
                
                <xpath expr="//form//field[@name='client_order_ref']" position="attributes">
                    <attribute name="attrs">{'readonly': [('state', 'in', ['sale', 'done'])],'required': [('state', 'in', ['sale', 'done'])]}</attribute>
                </xpath>

                <xpath expr="//field[@name='order_line']/tree/field[@name='price_unit']" position="before">
                    <field name="mo_line" optional="show"/>
                    <field name="mp_line" optional="show"/>
                </xpath>

                <xpath expr="//field[@name='order_line']/tree/field[@name='product_uom']" position="attributes">
                    <attribute name="options">{'no_create': True, 'no_create_edit': True}</attribute>
                </xpath>
                <xpath expr="//field[@name='order_line']/tree/field[@name='product_uom']" position="before">
                    <field name="mto" invisible="1"/>
                </xpath>
            </field>
        </record>

        <record id="sale_order_os_tree" model="ir.ui.view">
            <field name="name">sale.order.os.tree</field>
            <field name="inherit_id" ref="sale.view_quotation_tree"/>
            <field name="model">sale.order</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="ordem_servico" string="OS" widget="many2many_tags" optional="show"/>
                </xpath>

                <xpath expr="//field[@name='amount_total']" position="before">
                    <field name="mediadesc" string="Desconto(%)" optional="show" avg="Media de Desconto"/>
                    <!--            <field name="discount_total" string="Total Desconto" optional="show" sum="Total Desconto"/>-->
                </xpath>

            </field>
        </record>

        <record id="sale_order_os_search" model="ir.ui.view">
       <field name="name">Filtro Sale OS</field>
       <field name="inherit_id" ref="sale.view_sales_order_filter" />
       <field name="model">sale.order</field>
       <field name="arch" type="xml">
           <xpath expr="//search/group" position="inside">
               <filter string="Ordem de Serviço" name="ordem_servico" domain="[]" context="{'group_by':'ordem_servico', 'default_order':'ordem_servico'}" />
           </xpath>
           <xpath expr="//search/field[@name='name']" position="after">
               <field name="ordem_servico"/>
               <filter string="Ordem de Serviço" name="ordem_servico" domain="[('ordem_servico', '!=', False)]" context="{'order': 'ordem_servico desc'}"/>
           </xpath>
       </field>
    </record>
        
        <record id="custom_ir_attachment_tree_view" model="ir.ui.view">
            <field name="name">ir.attachment.custom.tree</field>
            <field name="model">ir.attachment</field>
            <field name="arch" type="xml">
                <tree string="Anexos">
                    <field name="name"/>
                    <field name="file_size"/>
                    <header>
                        <button name="unlink" 
                                type="object" 
                                string="Excluir"
                                icon="fa-trash"
                                class="oe_highlight" 
                                confirm="Deseja realmente excluir este arquivo?"/>
                    </header>
                </tree>
            </field>
        </record>

        <record id="ir_attachment_search_view_custom" model="ir.ui.view">
        <field name="name">ir.attachment.custom.search</field>
        <field name="model">ir.attachment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Meus Anexos" name="my_attachments" domain="[('create_uid', '=', uid)]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Tipo" name="group_by_type" context="{'group_by': 'mimetype'}"/>
                </group>
            </search>
        </field>
        </record>

        <record id="view_confirm_mto_wizard_form" model="ir.ui.view">
        <field name="name">confirm.mto.wizard.form</field>
        <field name="model">confirm.mto.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirmar Pedido com MTO">
                <sheet>
                    <div class="oe_title">
                        <h1>Confirmação de Pedido</h1>
                    </div>
                    <div>
                        <field name="message" widget="html" readonly="1"/>
                    </div>
                </sheet>
                <footer>
                    <button name="action_cancel" string="Não" class="btn-secondary" type="object"/>
                    <button name="action_confirm" string="Sim" class="btn-primary" type="object"/>
                </footer>
            </form>
        </field>
        </record>
   
</odoo>
