<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="os_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">os.res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="25"/>
        <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='work_organization_setting_container']" position="before">
                <h2>Parâmetros de horas</h2>
                <div class="row mt16 o_settings_container" name="param_horas">

                    <!-- Campo Horas Mensais -->
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="horasmensais" required="1" class="o_light_label"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="horasmensais"/>
                            <div class="text-muted">
                                Insira o total de horas mensais líquidas.
                            </div>
                        </div>
                    </div>

                    <!-- Campo Funcionários -->
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="funcionarios" required="1"
                                   class="o_light_label"
                                   widget="many2many_tags"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="funcionarios"/>
                            <div class="text-muted">
                                Insira os funcionários disponíveis para produção.
                            </div>
                        </div>
                    </div>

                    <!-- Campo Total Horas -->
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="totalhoras" class="o_light_label" readonly="1"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="totalhoras"/>
                            <div class="text-muted">
                                Total de horas (calculado automaticamente).
                            </div>
                        </div>
                    </div>

                    <!-- Campo Entrada -->
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="entrada" class="o_light_label"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="entrada"/>
                            <div class="text-muted">
                                Horário de entrada padrão.
                            </div>
                        </div>
                    </div>

                    <!-- Campo Saída -->
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="saida" class="o_light_label"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="saida"/>
                            <div class="text-muted">
                                Horário de saída padrão.
                            </div>
                        </div>
                    </div>

                </div>
            </xpath>
        </field>
    </record>
</odoo>