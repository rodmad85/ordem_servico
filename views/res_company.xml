        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
                <notebook>
                <page
                    name="ordem_servico"
                    string="Ordem de Serviço"
                    groups="ordem_servico.ordem_admin"
                >
