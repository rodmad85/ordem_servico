<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_print_resumo" model="ir.actions.report">
        <field name="name">Resumo OS</field>
        <field name="model">os.fechamento</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ordem_servico.report_resumo</field>
        <field name="report_file">ordem_servico.report_resumo</field>
        <field name="print_report_name">'Resumo OS</field>
        <field name="binding_model_id" ref="model_os_resumo"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_os_resumo_document">
        <t t-call="web.external_layout">
            <div class="page">
                <h2>Resumo de Ordens de Serviço</h2>
                <p>
                    <strong>Data:</strong>
                    <t t-esc="format_date(fields.Date.today())"/>
                </p>

                <table class="table table-sm table-bordered">
                    <thead>
                        <tr>
                            <th>OS</th>
                            <th>Cliente</th>
                            <th>Valor Pedido</th>
                            <th>Data Entrega</th>
                            <th>MP Prevista</th>
                            <th>MP Real</th>
                            <th>% Compras</th>
                            <th>Dif. Compra</th>
                            <th>Horas Prev.</th>
                            <th>Horas Real</th>
                            <th>% Horas</th>
                            <th>Dif. Horas</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="docs" t-as="linha">
                            <tr>
                                <td><t t-esc="linha.os_id"/></td>
                                <td><t t-esc="linha.cliente"/></td>
                                <td><t t-esc="linha.valor_pedido"/></td>
                                <td><t t-esc="linha.data_entrega"/></td>
                                <td><t t-esc="linha.mp_prevista"/></td>
                                <td><t t-esc="linha.mp_real"/></td>
                                <td><t t-esc="linha.progress_compra"/>%</td>
                                <td><t t-esc="linha.diff_compra"/></td>
                                <td><t t-esc="linha.horas_prevista"/></td>
                                <td><t t-esc="linha.horas_real"/></td>
                                <td><t t-esc="linha.perc_horas"/>%</td>
                                <td><t t-esc="linha.diff_horas"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <h4 class="mt-3">Totais</h4>
                <ul>
                    <li><strong>Total Horas Previstas:</strong> <t t-esc="sum(docs.mapped('horas_prevista'))"/></li>
                    <li><strong>Total Horas Reais:</strong> <t t-esc="sum(docs.mapped('horas_real'))"/></li>
                    <li><strong>Total MP Prevista:</strong> <t t-esc="sum(docs.mapped('mp_prevista'))"/></li>
                    <li><strong>Total MP Real:</strong> <t t-esc="sum(docs.mapped('mp_real'))"/></li>
                </ul>
            </div>
        </t>
    </template>


   
</odoo>
